# Copy to .env and fill in. Nothing runs paid until a key exists.

# --- LiteLLM gateway (docker compose up litellm) ---
LITELLM_MASTER_KEY=sk-cortex-local          # any string; clients auth to the proxy with this
OPENROUTER_API_KEY=                         # free-tier models — https://openrouter.ai/keys
GROQ_API_KEY=                               # free-tier fast inference — https://console.groq.com/keys
ANTHROPIC_API_KEY=                          # paid, premium tier — https://console.anthropic.com

# --- Cortex ---
CORTEX_DB=data/cortex.db
CORTEX_GATEWAY_URL=http://localhost:4000
